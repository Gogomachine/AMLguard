# Twitter / X
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

# News digest (comma-separated RSS/HTML URLs)
NEWS_SOURCES=https://www.chainalysis.com/blog/feed,https://www.elliptic.co/blog/rss.xml,https://www.trmlabs.com/category/insights,https://www.trmlabs.com/category/trm-investigations,https://www.trmlabs.com/category/foundations,https://www.acamstoday.org/feed/,https://www.fatf-gafi.org/en/the-fatf/news.html,https://www.coindesk.com/arc/outboundfeeds/rss/?category=policy,https://forklog.com/feed
DIGEST_MORNING_HOUR=9
DIGEST_EVENING_HOUR=18

# App settings
DATABASE_URL=sqlite+aiosqlite:///./txpeek.db
LOG_LEVEL=INFO
